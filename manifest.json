{
  "manifest_version": 3,
  "name": "Spark Study Assistant",
  "description": "Đọc bài tập trong iframe của NGL Spark, gợi ý đáp án và hỗ trợ điền đáp án sau khi xem trước.",
  "version": "0.1.0",
  "default_locale": "vi",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spark Study Assistant"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "https://learn.eltngl.com/*",
    "https://*.avallain.net/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://learn.eltngl.com/*",
        "https://*.avallain.net/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
